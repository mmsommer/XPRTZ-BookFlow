        Blob[("Azure Blob Storage<br/>manuscripts / proofprints / event-grid-dead-letter")]
        KeyVault["Azure Key Vault<br/>Integration credentials"]

        subgraph Bus["Azure Service Bus - bookflow-events topic"]
            Topic["Durable event fan-out"]
            AssignmentSub["editor-assignment"]
            ProofprintSub["proofprint-generation"]
            ProgressSub["progress-tracking"]
            PrintingSub["print-demand-orders"]
            InventorySub["inventory"]
            Topic --> AssignmentSub
