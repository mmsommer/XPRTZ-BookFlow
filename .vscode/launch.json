{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "BookFlow API Frontend",
      "type": "coreclr",
      "request": "launch",
      "program": "${workspaceFolder}/src/BookFlow.ApiFrontend/bin/Debug/net10.0/BookFlow.ApiFrontend.dll",
      "cwd": "${workspaceFolder}/src/BookFlow.ApiFrontend",
      "console": "integratedTerminal",
      "stopAtEntry": false,
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "ASPNETCORE_URLS": "http://127.0.0.1:5100",
        "Authentication__SigningKey": "bookflow-vscode-local-only-signing-key-2026",
        "BookFlow__Mode": "Local",
        "BookFlow__BlobRoot": "${workspaceFolder}/src/.local/blobs",
        "BookFlow__FrontendUrl": "http://127.0.0.1:5100/",
        "BookFlow__WebAppUrl": "http://127.0.0.1:5102/",
        "BookFlow__NotificationsUrl": "http://127.0.0.1:5103/",
        "BookFlow__ListingHosts__0": "shop.example.test",
        "ConnectionStrings__BookFlow": "Data Source=${workspaceFolder}/src/BookFlow.WebApp/.bookflow-local.db;Default Timeout=30"
      }
    },
    {
      "name": "BookFlow Local Providers",
      "type": "coreclr",
