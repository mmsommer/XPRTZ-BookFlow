      "stopAtEntry": false,
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "ASPNETCORE_URLS": "http://127.0.0.1:5101",
        "Providers__Token": "bookflow-vscode-local-provider-token",
        "Providers__StoreRoot": "${workspaceFolder}/src/.local/providers"
      }
    },
